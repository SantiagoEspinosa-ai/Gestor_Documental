# Copiar a .env y rellenar. NUNCA commitear .env
APP_ENV=dev
# Firma de los JWT. Obligatoria en todos los entornos: al menos 32 caracteres y nunca este valor de ejemplo
# (con el, la API no arranca). Genera uno propio con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIA_ESTO_EN_PRODUCCION
JWT_EXPIRA_MINUTOS=480

DATABASE_URL=postgresql+psycopg://gestor:gestor@db:5432/gestor

# Carpeta de los YAML de config/: vacia = config/ de la raiz del repo; en Docker la fija docker-compose
CONFIG_DIR=
# Carpeta de los prompts versionados: vacia = prompts/ de la raiz del repo; en Docker la fija docker-compose
PROMPTS_DIR=
# Tamano maximo de cada archivo subido, en MB (ADR-006 1.4)
TAMANO_MAXIMO_ARCHIVO_MB=20
# Zona horaria del negocio (IANA): decide el anio de cada folio
ZONA_HORARIA=America/Mexico_City
# Origenes del navegador que pueden llamar a la API (CORS), separados por comas; en Docker y en local,
# el de Vite. Nunca "*": la API no arranca con el comodin
CORS_ORIGENES=http://localhost:5173

# Repositorio de objetos: Amazon S3 real (sin MinIO ni emuladores).
# Claves del usuario IAM del proyecto; las entrega PERSONA_1 por canal seguro, nunca por el repo.
AWS_ACCESS_KEY_ID=TU_CLAVE_AQUI
AWS_SECRET_ACCESS_KEY=TU_CLAVE_AQUI
AWS_REGION=us-east-1
S3_BUCKET=gestor-documental-dev
# Segundos que vale una URL prefirmada para ver un original
URL_PREFIRMADA_SEGUNDOS=300

# Modelos de IA (docs/motor_ia/SPEC_CONFIGURACION.md, seccion 2)
# OLLAMA_BASE_URL segun donde corre el backend (o el CLI) y donde corre Ollama:
#   - backend o CLI en el equipo (venv), con Ollama instalado en el equipo: http://localhost:11434
#   - backend en un contenedor, con Ollama instalado en el equipo (Docker Desktop): http://host.docker.internal:11434
#     (valor por defecto: con "docker compose up" normal el servicio ollama no arranca, es un perfil opcional)
#   - backend en un contenedor, con "docker compose --profile ollama up": http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Vision (pdf_escaneado, imagen) y texto (pdf_digital), elegidos en las pruebas de docs/motor_ia/pruebas_ollama.md
OLLAMA_MODELO_VISION=qwen2.5vl:3b
OLLAMA_MODELO_TEXTO=gemma4:e2b
# Segundos base del limite de cada peticion de vision (+150 s por imagen). 180 cubre el primer uso con
# OLLAMA_MAX_LOADED_MODELS=1: cambiar de modelo, cargar qwen2.5vl:3b e inferir (spec del motor, seccion 13)
OLLAMA_TIMEOUT_VISION_BASE_S=180
# Documentos que se analizan a la vez (un solo proceso uvicorn). Con Ollama sin GPU, 1; y arrancar
# Ollama con OLLAMA_MAX_LOADED_MODELS=1 para que no cargue varios modelos en memoria
MAX_PROCESAMIENTOS_SIMULTANEOS=1
# Al arrancar la API, relanzar los analisis que un reinicio dejo a medias (pendiente o procesando).
# Vale para un solo proceso uvicorn; con varios workers haria falta una cola
REANUDAR_ANALISIS_AL_ARRANCAR=true
# Veces que se relanza un mismo analisis interrumpido. Al superarlo, el documento pasa a error con SYS-007
# ("reintentos agotados al reanudar el analisis"): asi un documento que tumba la API (p. ej. por RAM) no la tumba en bucle
MAX_REINTENTOS_REANUDAR=3
# Motor de analisis (H10): real = orquestador de PERSONA_2 con Ollama (por defecto). stub solo para pruebas
# sin Ollama (e2e de humo). Otro valor: la API no arranca
MOTOR_ANALISIS=real
# Proveedor comercial: OpenRouter GRATUITO (ADR-003), solo respaldo de Ollama y solo con fixtures.
# Clave gratuita: la crea PERSONA_2 y la comparte por canal seguro. Sin saldo ni tarjeta.
PROVEEDOR_COMERCIAL=openrouter
PROVEEDOR_COMERCIAL_BASE_URL=https://openrouter.ai/api/v1
PROVEEDOR_COMERCIAL_MODELO=TU_MODELO_AQUI:free
PROVEEDOR_COMERCIAL_API_KEY=TU_CLAVE_AQUI
# Barrera de privacidad (ADR-003): con false, un proveedor con "privado: false" en config/modelos.yaml
# (OpenRouter) no se usa nunca, ni como respaldo. Activarla solo en desarrollo y con fixtures ficticios.
PERMITIR_PROVEEDORES_NO_PRIVADOS=false

# OCR
TESSERACT_LANG=spa+eng
# Limites antes de procesar un documento (seguridad: un PDF con miles de paginas o una pagina gigante agotarian
# la RAM). Si se superan, el documento queda en error sin renderizarse. 50 MP admite una foto de movil de 48 MP
MAX_PAGINAS_DOCUMENTO=20
MAX_PIXELES_PAGINA=50000000

# Webhooks: secreto del HMAC-SHA256 de la cabecera X-Firma (core/webhooks.py). Vacio = no se envian webhooks. Si
# tiene valor: al menos 32 caracteres y nunca este de ejemplo (la API no arranca); se genera con el mismo comando
# que SECRET_KEY. Fuera de dev, solo a URL https. La URL de cada proceso va en config/procesos.yaml
WEBHOOK_SECRET_HMAC=CAMBIA_ESTO
