# Copiar a .env y rellenar. NUNCA commitear .env
APP_ENV=dev
SECRET_KEY=CAMBIA_ESTO_EN_PRODUCCION
JWT_EXPIRA_MINUTOS=480

DATABASE_URL=postgresql+psycopg://gestor:gestor@db:5432/gestor

# Carpeta de los YAML de config/: vacia = config/ de la raiz del repo; en Docker la fija docker-compose
CONFIG_DIR=
# Tamano maximo de cada archivo subido, en MB (ADR-006 1.4)
TAMANO_MAXIMO_ARCHIVO_MB=20
# Zona horaria del negocio (IANA): decide el anio de cada folio
ZONA_HORARIA=America/Mexico_City

# Repositorio de objetos: Amazon S3 real (sin MinIO ni emuladores).
# Claves del usuario IAM del proyecto; las entrega PERSONA_1 por canal seguro, nunca por el repo.
AWS_ACCESS_KEY_ID=TU_CLAVE_AQUI
AWS_SECRET_ACCESS_KEY=TU_CLAVE_AQUI
AWS_REGION=us-east-1
S3_BUCKET=gestor-documental-dev

# Modelos de IA
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODELO_VISION=llama3.2-vision:11b
OLLAMA_MODELO_TEXTO=qwen2.5:7b
# Proveedor comercial: OpenRouter GRATUITO (ADR-003), solo respaldo de Ollama y solo con fixtures.
# Clave gratuita: la crea PERSONA_2 y la comparte por canal seguro. Sin saldo ni tarjeta.
PROVEEDOR_COMERCIAL=openrouter
PROVEEDOR_COMERCIAL_BASE_URL=https://openrouter.ai/api/v1
PROVEEDOR_COMERCIAL_MODELO=TU_MODELO_AQUI:free
PROVEEDOR_COMERCIAL_API_KEY=TU_CLAVE_AQUI

# OCR
TESSERACT_LANG=spa+eng

# Webhooks
WEBHOOK_SECRET_HMAC=CAMBIA_ESTO
