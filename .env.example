# Copiar a .env y rellenar. NUNCA commitear .env
APP_ENV=dev
SECRET_KEY=CAMBIA_ESTO_EN_PRODUCCION
JWT_EXPIRA_MINUTOS=480

DATABASE_URL=postgresql+psycopg://gestor:gestor@db:5432/gestor

# Rutas dentro del contenedor (docker-compose monta ./config y ./prompts ahi).
# Fuera de Docker: CONFIG_DIR=../config y PROMPTS_DIR=../prompts desde backend/.
CONFIG_DIR=/config
PROMPTS_DIR=/prompts
CONOCIMIENTO_DIR=/conocimiento

# Repositorio de objetos (Amazon S3).
# Desarrollo local sin cuenta AWS: servicio `minio` de docker-compose ->
#   S3_ENDPOINT_URL=http://minio:9000 y las credenciales de MINIO_ROOT_* abajo.
AWS_ACCESS_KEY_ID=TU_CLAVE_AQUI
AWS_SECRET_ACCESS_KEY=TU_CLAVE_AQUI
AWS_REGION=us-east-1
S3_BUCKET=gestor-documental-dev
S3_ENDPOINT_URL=
# Cifrado en reposo (diapositiva 12): AES256 = SSE-S3; aws:kms si se usa KMS.
S3_CIFRADO=AES256

# Solo para el servicio minio local
MINIO_ROOT_USER=TU_USUARIO_AQUI
MINIO_ROOT_PASSWORD=TU_CLAVE_AQUI

# Modelos de IA (dos modelos locales = requisito MVP de la diapositiva 13)
OLLAMA_BASE_URL=http://ollama:11434
# Vision: alternativa mas ligera qwen2.5vl:7b. (Sin comentarios en la misma linea:
# docker compose los incluiria en el valor.)
OLLAMA_MODELO_VISION=llama3.2-vision:11b
OLLAMA_MODELO_TEXTO=qwen2.5:7b
OLLAMA_MODELO_EMBEDDINGS=nomic-embed-text
# Proveedor comercial [A ACORDAR] ADR-003. Deja vacio hasta decidirlo.
PROVEEDOR_COMERCIAL=
PROVEEDOR_COMERCIAL_MODELO=
PROVEEDOR_COMERCIAL_API_KEY=TU_CLAVE_AQUI

# OCR
TESSERACT_LANG=spa+eng

# Webhooks
WEBHOOK_SECRET_HMAC=CAMBIA_ESTO
